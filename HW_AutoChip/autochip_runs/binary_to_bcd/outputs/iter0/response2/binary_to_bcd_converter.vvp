#! /opt/homebrew/Cellar/icarus-verilog/13.0/bin/vvp
:ivl_version "13.0 (stable)" "(v13_0)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/system.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_sys.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/vhdl_textio.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2005_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/va_math.vpi";
:vpi_module "/opt/homebrew/Cellar/icarus-verilog/13.0/lib/ivl/v2009.vpi";
S_0x150e0a310 .scope package, "$unit" "$unit" 2 1;
 .timescale 0 0;
S_0x150e07910 .scope module, "tb" "tb" 3 3;
 .timescale -9 -12;
v0x150e22c70_0 .net "bcd_output", 7 0, v0x150e0a480_0;  1 drivers
v0x150e22d30_0 .var "binary_input", 4 0;
v0x150e22de0_0 .var "expected_bcd", 7 0;
v0x150e22e90_0 .var/i "i", 31 0;
v0x150e22f40_0 .var/i "mismatches", 31 0;
v0x150e23030_0 .var "test_binary", 4 0;
S_0x150e07a80 .scope module, "uut" "binary_to_bcd_converter" 3 15, 4 1 0, S_0x150e07910;
 .timescale 0 0;
    .port_info 0 /INPUT 5 "binary_input";
    .port_info 1 /OUTPUT 8 "bcd_output";
v0x150e0a480_0 .var "bcd_output", 7 0;
v0x150e22af0_0 .net "binary_input", 4 0, v0x150e22d30_0;  1 drivers
v0x150e22b90_0 .var/i "i", 31 0;
E_0x150e0a7a0 .event anyedge, v0x150e0a480_0, v0x150e22af0_0;
    .scope S_0x150e07a80;
T_0 ;
    %wait E_0x150e0a7a0;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x150e0a480_0, 0, 8;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x150e22b90_0, 0, 32;
T_0.0 ; Top of for-loop
    %load/vec4 v0x150e22b90_0;
    %cmpi/s 5, 0, 32;
	  %jmp/0xz T_0.1, 5;
    %load/vec4 v0x150e0a480_0;
    %parti/s 7, 0, 2;
    %concati/vec4 0, 0, 1;
    %store/vec4 v0x150e0a480_0, 0, 8;
    %load/vec4 v0x150e0a480_0;
    %parti/s 4, 0, 2;
    %pad/u 32;
    %cmpi/u 5, 0, 32;
    %flag_inv 5; GE is !LT
    %jmp/0xz  T_0.3, 5;
    %load/vec4 v0x150e0a480_0;
    %parti/s 4, 0, 2;
    %addi 3, 0, 4;
    %ix/load 4, 0, 0;
    %flag_set/imm 4, 0;
    %store/vec4 v0x150e0a480_0, 4, 4;
T_0.3 ;
    %load/vec4 v0x150e0a480_0;
    %parti/s 4, 4, 4;
    %pad/u 32;
    %cmpi/u 5, 0, 32;
    %flag_inv 5; GE is !LT
    %jmp/0xz  T_0.5, 5;
    %load/vec4 v0x150e0a480_0;
    %parti/s 4, 4, 4;
    %addi 3, 0, 4;
    %ix/load 4, 4, 0;
    %flag_set/imm 4, 0;
    %store/vec4 v0x150e0a480_0, 4, 4;
T_0.5 ;
    %load/vec4 v0x150e22af0_0;
    %pushi/vec4 4, 0, 32;
    %load/vec4 v0x150e22b90_0;
    %sub;
    %part/s 1;
    %ix/load 4, 0, 0;
    %flag_set/imm 4, 0;
    %store/vec4 v0x150e0a480_0, 4, 1;
T_0.2 ; for-loop step statement
    %load/vec4 v0x150e22b90_0;
    %addi 1, 0, 32;
    %store/vec4 v0x150e22b90_0, 0, 32;
    %jmp T_0.0;
T_0.1 ; for-loop exit label
    %jmp T_0;
    .thread T_0, $push;
    .scope S_0x150e07910;
T_1 ;
    %vpi_call/w 3 21 "$dumpfile", "my_design.vcd" {0 0 0};
    %vpi_call/w 3 22 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x150e07910 {0 0 0};
    %vpi_call/w 3 24 "$display", "Testing Binary-to-BCD Converter..." {0 0 0};
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x150e22f40_0, 0, 32;
    %pushi/vec4 0, 0, 5;
    %store/vec4 v0x150e22d30_0, 0, 5;
    %pushi/vec4 0, 0, 5;
    %store/vec4 v0x150e23030_0, 0, 5;
    %pushi/vec4 0, 0, 8;
    %store/vec4 v0x150e22de0_0, 0, 8;
    %pushi/vec4 0, 0, 32;
    %store/vec4 v0x150e22e90_0, 0, 32;
T_1.0 ; Top of for-loop
    %load/vec4 v0x150e22e90_0;
    %cmpi/s 32, 0, 32;
	  %jmp/0xz T_1.1, 5;
    %load/vec4 v0x150e22e90_0;
    %pad/s 5;
    %store/vec4 v0x150e23030_0, 0, 5;
    %load/vec4 v0x150e23030_0;
    %store/vec4 v0x150e22d30_0, 0, 5;
    %load/vec4 v0x150e23030_0;
    %pad/u 32;
    %pushi/vec4 10, 0, 32;
    %mod;
    %pad/u 4;
    %ix/load 4, 0, 0;
    %flag_set/imm 4, 0;
    %store/vec4 v0x150e22de0_0, 4, 4;
    %load/vec4 v0x150e23030_0;
    %pad/u 32;
    %pushi/vec4 10, 0, 32;
    %div;
    %pad/u 4;
    %ix/load 4, 4, 0;
    %flag_set/imm 4, 0;
    %store/vec4 v0x150e22de0_0, 4, 4;
    %delay 10000, 0;
    %load/vec4 v0x150e22c70_0;
    %load/vec4 v0x150e22de0_0;
    %cmp/ne;
    %jmp/0xz  T_1.3, 6;
    %load/vec4 v0x150e22f40_0;
    %addi 1, 0, 32;
    %store/vec4 v0x150e22f40_0, 0, 32;
    %vpi_call/w 3 46 "$display", "Error: Test case %0d failed. Expected BCD: 8'b%08b, Got: 8'b%08b", v0x150e23030_0, v0x150e22de0_0, v0x150e22c70_0 {0 0 0};
T_1.3 ;
T_1.2 ; for-loop step statement
    %load/vec4 v0x150e22e90_0;
    %addi 1, 0, 32;
    %store/vec4 v0x150e22e90_0, 0, 32;
    %jmp T_1.0;
T_1.1 ; for-loop exit label
    %vpi_call/w 3 56 "$display", "Mismatches: %0d in 32 samples", v0x150e22f40_0 {0 0 0};
    %end;
    .thread T_1;
# The file index is used to find the file name in the following table.
:file_names 5;
    "N/A";
    "<interactive>";
    "-";
    "binary_to_bcd_tb.v";
    "outputs/iter0/response2/binary_to_bcd_converter.sv";
