user: We are designing a very small accumulator-based 8-bit processor.

The design is constrained for a small ASIC implementation, approximately 1000 standard cells, so the architecture should remain simple.

Requirements:

- 8-bit accumulator-based architecture
- Every instruction is exactly one byte (8 bits)
- No multi-byte instructions
- 4-bit program counter, allowing 16 instruction locations
- One instruction executes on each rising edge of the clock when enable is high
- Active-low reset
- Keep the implementation simple and synthesizable

Instruction format:

    instruction[7:4] = 4-bit opcode
    instruction[3:0] = 4-bit operand

ISA:

    4'h0 : NOP
            No operation.

    4'h1 : LDI imm4
            accumulator = zero-extended immediate

    4'h2 : ADD imm4
            accumulator = accumulator + zero-extended immediate

    4'h3 : SUB imm4
            accumulator = accumulator - zero-extended immediate

    4'h4 : AND imm4
            accumulator = accumulator AND zero-extended immediate

    4'h5 : OR imm4
            accumulator = accumulator OR zero-extended immediate

    4'h6 : XOR imm4
            accumulator = accumulator XOR zero-extended immediate

    4'h7 : SHL
            accumulator = accumulator << 1

    4'h8 : SHR
            accumulator = accumulator >> 1

    4'h9 : INC
            accumulator = accumulator + 1

    4'hA : DEC
            accumulator = accumulator - 1

    4'hB : IN
            accumulator = in_port

    4'hC : OUT
            out_port = accumulator
            out_valid should pulse high for this cycle

    4'hD : JMP addr4
            pc = operand

    4'hE : JZ addr4
            if accumulator == 0:
                pc = operand
            else:
                pc = pc + 1

    4'hF : HALT
            halted = 1 and execution stops

For all instructions except JMP, JZ when taken, and HALT,
the program counter should advance by one.

When enable is low, the CPU should hold its state.

out_valid should normally be 0 and pulse high only when an OUT instruction executes.

When halted is high, the processor should stop changing state.

On reset:

    pc = 0
    accumulator = 0
    out_port = 0
    out_valid = 0
    halted = 0

Complete the following synthesizable SystemVerilog module:

module cpu_8bit (
    input wire clk,
    input wire reset_n,
    input wire enable,
    input wire [7:0] instruction,
    input wire [7:0] in_port,

    output reg [3:0] pc,
    output reg [7:0] accumulator,
    output reg [7:0] out_port,
    output reg out_valid,
    output reg halted
);

    // Insert your implementation here

endmodule

assistant: module cpu_8bit (
    input wire clk,
    input wire reset_n,
    input wire enable,
    input wire [7:0] instruction,
    input wire [7:0] in_port,

    output reg [3:0] pc,
    output reg [7:0] accumulator,
    output reg [7:0] out_port,
    output reg out_valid,
    output reg halted
);
    
    // State initialization
    always @(posedge clk or negedge reset_n) begin
        if (!reset_n) begin
            pc <= 4'd0;
            accumulator <= 8'd0;
            out_port <= 8'd0;
            out_valid <= 1'b0;
            halted <= 1'b0;
        end else if (enable && !halted) begin
            out_valid <= 1'b0; // Default to low
            
            case (instruction[7:4]) 
                4'h0: ; // NOP
                4'h1: accumulator <= {4'b0000, instruction[3:0]}; // LDI
                4'h2: accumulator <= accumulator + {4'b0000, instruction[3:0]}; // ADD
                4'h3: accumulator <= accumulator - {4'b0000, instruction[3:0]}; // SUB
                4'h4: accumulator <= accumulator & {4'b0000, instruction[3:0]}; // AND
                4'h5: accumulator <= accumulator | {4'b0000, instruction[3:0]}; // OR
                4'h6: accumulator <= accumulator ^ {4'b0000, instruction[3:0]}; // XOR
                4'h7: accumulator <= accumulator << 1; // SHL
                4'h8: accumulator <= accumulator >> 1; // SHR
                4'h9: accumulator <= accumulator + 1; // INC
                4'hA: accumulator <= accumulator - 1; // DEC
                4'hB: accumulator <= in_port; // IN
                4'hC: begin // OUT
                    out_port <= accumulator;
                    out_valid <= 1'b1; // Pulse out_valid
                end
                4'hD: pc <= instruction[3:0]; // JMP
                4'hE: begin // JZ
                    if (accumulator == 8'd0)
                        pc <= instruction[3:0];
                    else
                        pc <= pc + 1;
                end
                4'hF: halted <= 1'b1; // HALT
            endcase
            
            // Increment PC for all operations except jumps or halt
            if (instruction[7:4] != 4'hD && instruction[7:4] != 4'hE && instruction[7:4] != 4'hF) begin
                pc <= pc + 1;
            end
        end
    end
    
endmodule


